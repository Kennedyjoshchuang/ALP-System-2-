# PT. Alpha Logistics Prakarsa - Environment Variables Template
# Copy this file to '.env' and fill in your actual values.

# Supabase API Credentials
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Server settings
PORT=5000
NODE_ENV=development

# VPS Deployment configurations (Used by deploy_vps.cjs)
# VPS_IP=12.34.56.78
# VPS_USER=root
# VPS_PASS=your_vps_root_password
# SUPABASE_ANON_KEY=your-supabase-anon-key
# SUPABASE_DB_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
