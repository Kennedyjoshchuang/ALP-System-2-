# PT. Alpha Logistics Prakarsa - Environment Variables Template
# Copy this file to '.env' and fill in your actual values.

# Supabase API Credentials
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Server settings
PORT=5000
NODE_ENV=development

# VPS Deployment configurations (Used by deploy_vps.cjs)
# VPS_IP=12.34.56.78
# VPS_USER=root
# VPS_PASS=your_vps_root_password
# SUPABASE_ANON_KEY=your-supabase-anon-key
# SUPABASE_DB_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Google Gemini API (Chatbot Brain)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# WhatsApp Bot Settings (Baileys)
WA_BOT_ENABLED=true
WA_BOT_NAME=ALPBot
WA_AUTHORIZED_GROUP_ID=
WA_AUTHORIZED_PHONE_NUMBERS=
WA_BOT_PREFIX=!bot

# Google Cloud Integration (getfamiliaradmin@gmail.com)
# Option B (OAuth2 Zero Cost):
GOOGLE_CLIENT_ID=your_oauth_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_oauth_client_secret_here
GOOGLE_REFRESH_TOKEN=your_oauth_refresh_token_here
GOOGLE_REDIRECT_URI=http://localhost:5000/api/google/oauth/callback

# Google Sheets & Google Drive Target IDs
GOOGLE_SPREADSHEET_ID=1QAwKwDpI3Q7PAUHt68Ua2qX5tByva2swFrKJzSQw1iQ
GOOGLE_DRIVE_INVOICE_FOLDER_ID=10SDj7I0yid-FMYPlykZRdaw15v3qv4sL
